
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        APP_DIR = "${WORKSPACE}/ex9"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
        VENV_DIR = "${WORKSPACE}/ex9/.venv"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Installing Python dependencies...'

                sh '''
                    set -eu

                    cd "$APP_DIR"

                    python3 --version
                    python3 -m venv "$VENV_DIR"

                    "$VENV_DIR/bin/python" -m pip install --upgrade pip
                    "$VENV_DIR/bin/python" -m pip install -r requirements.txt

                    echo "Build completed successfully"
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'

                sh '''
                    set -eu

                    cd "$APP_DIR"

                    "$VENV_DIR/bin/python" -m unittest discover \
                        -s . -p 'test_*.py' -v
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application files...'

                sh '''
                    set -eu

                    mkdir -p "$DEPLOY_DIR"

                    cp "$APP_DIR/app.py" "$DEPLOY_DIR/"
                    cp "$APP_DIR/requirements.txt" "$DEPLOY_DIR/"

                    test -f "$DEPLOY_DIR/app.py"
                    test -f "$DEPLOY_DIR/requirements.txt"

                    echo "Deployment files:"
                    ls -l "$DEPLOY_DIR"
                '''
            }
        }

        stage('Run and Verify Application') {
            steps {
                echo 'Starting Flask and verifying HTTP response...'

                sh '''
                    set -eu

                    cd "$DEPLOY_DIR"

                    nohup "$VENV_DIR/bin/python" app.py \
                        > app.log 2>&1 &

                    APP_PID=$!
                    echo "$APP_PID" > app.pid

                    cleanup() {
                        kill "$APP_PID" 2>/dev/null || true
                        wait "$APP_PID" 2>/dev/null || true
                    }

                    trap cleanup EXIT

                    "$VENV_DIR/bin/python" - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"
expected = "Hello, Jenkins Multi-Stage Pipeline!"
last_error = None

for attempt in range(20):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read().decode("utf-8")

            assert response.status == 200, (
                f"Unexpected status: {response.status}"
            )
            assert body == expected, (
                f"Unexpected response: {body}"
            )

            print("HTTP status:", response.status)
            print("Response:", body)
            print("Application verification successful")
            break

    except Exception as exc:
        last_error = exc
        time.sleep(1)
else:
    raise SystemExit(
        f"Application verification failed: {last_error}"
    )
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Console Output for details.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}